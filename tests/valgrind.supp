{
   <libsodium-internal-alloc>
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   obj:*libsodium*
}

{
   <openssl-internal-alloc>
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   obj:*libcrypto*
}

{
   <sqlcipher-internal-alloc>
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   obj:*libsqlcipher*
}

{
   <ncurses-internal-alloc>
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   obj:*libncurses*
}

{
   <libstdcpp-internal-alloc>
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   obj:*libstdc++*
}
